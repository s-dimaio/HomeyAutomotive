    <!-- PermissionScreen (Google Play Compliant Prominent Disclosure) -->
    <string name="permission_screen_title">Location &amp; Smart Alerts</string>
    <string name="permission_step0_message">Homey collects location data to enable smart geofencing features, including departure warnings if a garage door or smart lock is left open and arrival prompts to open gates or doors, even when the app is closed or not in use.\n\nUsage &amp; Privacy:\n• Your precise location is accessed in real time solely to detect proximity to your home geofence.\n• All location processing occurs locally on your vehicle.\n• Location data is never used for advertising, never sold, and never shared with third parties or stored on external servers.\n\nThis feature is completely optional. You can decline and continue using all other features of Homey normally.</string>
    <string name="permission_step1_message">To deliver automated arrival and departure alerts while driving, Homey requires background location access.\n\nIn the next system dialog, please select \"Allow all the time\". This allows Homey to detect your home boundary even when the app is closed or not in use.\n\nYour location data is processed strictly on the vehicle and is never shared or stored.</string>
    <string name="permission_granted_message">All set! Background geofence alerts are now active.</string>
    <string name="permission_foreground_only_message">Foreground location granted. Smart Alerts are active while Homey is open on your car display.\n\nTo receive alerts when the app is closed, set location to \"Allow all the time\" in vehicle Settings → Apps → Homey.</string>
    <string name="permission_denied_message">Location access was declined. Proximity alerts cannot be activated without location permission. You can enable it at any time in vehicle Settings → Apps → Homey.</string>
    <string name="permission_btn_enable">Agree &amp; Continue</string>
    <string name="permission_btn_allow_always">Agree &amp; Continue</string>
    <string name="permission_btn_not_now">No thanks</string>

